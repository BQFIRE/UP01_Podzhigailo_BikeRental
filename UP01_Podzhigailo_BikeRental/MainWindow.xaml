<Window x:Class="UP01_Podzhigailo_BikeRental.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BikeRental — Аренда велосипедов и самокатов"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid Background="{DynamicResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0"
              Background="{DynamicResource PrimaryColor}">

            <Button x:Name="BackButton"
                    Content="← Назад"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="BackButton_Click"/>

            <TextBlock Text="BIKE RENTAL"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="ThemeSelector"
                      Width="145"
                      Height="30"
                      Margin="0,0,15,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      SelectionChanged="ThemeSelector_SelectionChanged">

                <ComboBoxItem Content="Светлая тема"/>
                <ComboBoxItem Content="Тёмная тема"/>

            </ComboBox>

        </Grid>

        <!-- Центральная область для страниц -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="{DynamicResource BackgroundColor}"/>

        <!-- Нижняя панель -->
        <Grid Grid.Row="2"
              Background="{DynamicResource BackgroundColor}">

            <TextBlock Text="Сервис аренды велосипедов и самокатов"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0"/>

            <TextBlock x:Name="DateTimeNow"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0"/>

        </Grid>

    </Grid>
</Window>
