<Window x:Class="UP01_Podzhigailo_BikeRental.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BikeRental — Аренда велосипедов и самокатов"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="{DynamicResource BackgroundColor}">

    <Grid Background="{DynamicResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0"
              Background="{DynamicResource PrimaryColor}">

            <Button x:Name="BackButton"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PrimaryColor}"
                    Click="BackButton_Click">

                <TextBlock Text="← Назад"
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Button>

            <TextBlock Text="BIKE RENTAL"
                       Foreground="#FFFFFF"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="ThemeSelector"
                      Width="180"
                      Height="32"
                      Margin="0,0,15,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      Background="{DynamicResource InputBackgroundColor}"
                      Foreground="{DynamicResource TextColor}"
                      BorderBrush="{DynamicResource BorderColor}"
                      SelectionChanged="ThemeSelector_SelectionChanged">

                <ComboBoxItem Content="Светлая тема"
                              Foreground="{DynamicResource TextColor}"
                              Background="{DynamicResource InputBackgroundColor}"
                              Padding="8,5"/>

                <ComboBoxItem Content="Тёмная тема"
                              Foreground="{DynamicResource TextColor}"
                              Background="{DynamicResource InputBackgroundColor}"
                              Padding="8,5"/>

            </ComboBox>

        </Grid>

        <!-- Центральная область для страниц -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="{DynamicResource BackgroundColor}"/>

        <!-- Нижняя панель -->
        <Grid Grid.Row="2"
              Background="{DynamicResource BackgroundColor}">

            <TextBlock Text="Сервис аренды велосипедов и самокатов"
                       Foreground="{DynamicResource TextColor}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0"/>

            <TextBlock x:Name="DateTimeNow"
                       Foreground="{DynamicResource TextColor}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0"/>

        </Grid>

    </Grid>
</Window>
