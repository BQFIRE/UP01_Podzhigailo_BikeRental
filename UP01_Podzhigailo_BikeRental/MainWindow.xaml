<Window x:Class="UP01_Podzhigailo_BikeRental.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BikeRental — Аренда велосипедов и самокатов"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Верхняя строка -->
        <Grid Grid.Row="0" Background="#263238">
            <Button x:Name="BackButton"
                    Content="← Назад"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="BackButton_Click"/>

            <TextBlock Text="BIKE RENTAL"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Центральная область для страниц -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <!-- Нижняя строка -->
        <Grid Grid.Row="2" Background="#ECEFF1">
            <TextBlock Text="Сервис аренды велосипедов и самокатов"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0"
                       Foreground="#263238"/>

            <TextBlock x:Name="DateTimeNow"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0"
                       Foreground="#263238"/>
        </Grid>
    </Grid>
</Window>
