<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="UP01_Podzhigailo_BikeRental.Pages.RentalsAdminPage"
      Title="Управление арендой"
      Background="{DynamicResource BackgroundColor}" av:DesignHeight="404.6" av:DesignWidth="847.423">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление арендой"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextColor}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Padding="14,6"
                    Margin="10,0,0,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    BorderThickness="0"
                    DockPanel.Dock="Right"/>

            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBackgroundColor}"
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="{DynamicResource BorderColor}"
                     ToolTip="Поиск по пользователю, модели или статусу"
                     TextChanged="SearchTextBox_TextChanged"/>
        </DockPanel>

        <DataGrid x:Name="RentalsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource CardColor}"
                  Foreground="{DynamicResource TextColor}"
                  BorderBrush="{DynamicResource BorderColor}"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,12">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding RentalID}"
                                    Width="55"/>
                <DataGridTextColumn Header="Пользователь"
                                    Binding="{Binding UserLogin}"
                                    Width="*"/>
                <DataGridTextColumn Header="Транспорт"
                                    Binding="{Binding VehicleModel}"
                                    Width="*"/>
                <DataGridTextColumn Header="Начало"
                                    Binding="{Binding StartTime}"
                                    Width="145"/>
                <DataGridTextColumn Header="Окончание"
                                    Binding="{Binding EndTime}"
                                    Width="145"/>
                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding TotalCost}"
                                    Width="100"/>
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding RentalStatus}"
                                    Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   x:Name="CountTextBlock"
                   Text="Количество аренд: 0"
                   Foreground="{DynamicResource SecondaryTextColor}"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Width="257"/>
    </Grid>
</Page>
