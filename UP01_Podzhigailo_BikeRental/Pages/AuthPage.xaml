<Page x:Class="UP01_Podzhigailo_BikeRental.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid Background="{DynamicResource BackgroundColor}">

        <Border Width="420"
                Padding="30"
                CornerRadius="12"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="BIKE RENTAL"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Аренда велосипедов и самокатов"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Вход в аккаунт"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Логин"
                           Margin="0,0,0,2"/>

                <TextBox x:Name="LoginTextBox"
                         MinHeight="38"
                         Margin="0,0,0,15"
                         ToolTip="Введите свой логин"/>

                <TextBlock Text="Пароль"
                           Margin="0,0,0,2"/>

                <PasswordBox x:Name="PasswordInput"
                             MinHeight="38"
                             Margin="0,0,0,20"
                             ToolTip="Введите пароль"/>

                <Button Content="Войти"
                        Height="42"
                        Margin="0,0,0,10"
                        Background="#00897B"
                        Click="LoginButton_Click"/>

                <Button Content="Регистрация"
                        Height="38"
                        Margin="0,0,0,10"
                        Click="RegisterButton_Click"/>

                <Button Content="Сменить пароль"
                        Height="38"
                        Click="ChangePasswordButton_Click"/>

                <TextBlock Text="Прокат в несколько нажатий"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Foreground="Gray"/>

            </StackPanel>
        </Border>

    </Grid>
</Page>
