<Page x:Class="UP01_Podzhigailo_BikeRental.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация"
      Background="{DynamicResource BackgroundColor}">

    <Grid Background="{DynamicResource BackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="520"
                    MaxWidth="600"
                    Padding="30"
                    CornerRadius="12"
                    Background="{DynamicResource CardColor}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="BIKE RENTAL"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Сервис аренды велосипедов и самокатов"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Вход в аккаунт"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Поля авторизации -->

                    <Label x:Name="labelLogin"
                           Content="Логин"
                           Foreground="{DynamicResource TextColor}"/>

                    <TextBox x:Name="LoginTextBox"
                             Height="40"
                             Padding="10,7"
                             FontSize="14"
                             Background="{DynamicResource InputBackgroundColor}"
                             Foreground="{DynamicResource TextColor}"
                             BorderBrush="{DynamicResource BorderColor}"
                             Margin="0,0,0,5"/>

                    <TextBlock x:Name="txtHintLogin"
                               Text="Введите ваш логин"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="12"
                               Margin="2,0,0,10"/>

                    <Label x:Name="labelPass"
                           Content="Пароль"
                           Foreground="{DynamicResource TextColor}"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="40"
                                 Padding="10,7"
                                 FontSize="14"
                                 Background="{DynamicResource InputBackgroundColor}"
                                 Foreground="{DynamicResource TextColor}"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 Margin="0,0,0,5"/>

                    <TextBlock x:Name="txtHintPass"
                               Text="Введите ваш пароль"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="12"
                               Margin="2,0,0,20"/>

                    <!-- Элементы капчи по методичке -->

                    <Label x:Name="labelCaptcha"
                           Content="Капча:"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,5"/>

                    <TextBox x:Name="captcha"
                             Height="42"
                             Width="200"
                             HorizontalAlignment="Center"
                             FontSize="20"
                             FontStyle="Italic"
                             FontWeight="Heavy"
                             Foreground="Red"
                             Background="{DynamicResource InputBackgroundColor}"
                             BorderBrush="{DynamicResource BorderColor}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"
                             ContextMenu="{x:Null}"
                             CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                             Margin="0,0,0,10"/>

                    <TextBox x:Name="captchaInput"
                             Height="36"
                             Width="200"
                             HorizontalAlignment="Center"
                             FontSize="14"
                             Padding="8,5"
                             Visibility="Collapsed"
                             Background="{DynamicResource InputBackgroundColor}"
                             Foreground="{DynamicResource TextColor}"
                             BorderBrush="{DynamicResource BorderColor}"
                             Margin="0,0,0,10"/>

                    <Button x:Name="submitCaptcha"
                            Height="38"
                            Width="200"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="submitCaptcha_Click"
                            Background="{DynamicResource AccentColor}"
                            BorderThickness="0"
                            Margin="0,0,0,15">
                        <TextBlock Text="Подтвердить"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <!-- Кнопки авторизации -->

                    <Button x:Name="LoginButton"
                            Height="42"
                            Click="LoginButton_Click"
                            Background="{DynamicResource AccentColor}"
                            BorderThickness="0"
                            Margin="0,0,0,10">
                        <TextBlock Text="Войти"
                                   Foreground="#FFFFFF"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <Button x:Name="RegisterButton"
                            Height="38"
                            Click="RegisterButton_Click"
                            Background="{DynamicResource PrimaryColor}"
                            BorderThickness="0"
                            Margin="0,0,0,10">
                        <TextBlock Text="Регистрация"
                                   Foreground="#FFFFFF"
                                   FontSize="14"/>
                    </Button>

                    <Button x:Name="ChangePasswordButton"
                            Height="38"
                            Click="ChangePasswordButton_Click"
                            Background="{DynamicResource PrimaryColor}"
                            BorderThickness="0">
                        <TextBlock Text="Сменить пароль"
                                   Foreground="#FFFFFF"
                                   FontSize="14"/>
                    </Button>

                    <TextBlock Text="© Bike Rental"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
