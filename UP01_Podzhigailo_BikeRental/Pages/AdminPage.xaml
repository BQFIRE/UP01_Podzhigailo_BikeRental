<Page x:Class="UP01_Podzhigailo_BikeRental.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="{DynamicResource BackgroundColor}">

    <Grid Background="{DynamicResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,25,20,20">
            <TextBlock Text="Панель администратора"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextColor}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Управление сервисом аренды велосипедов и самокатов"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2"
                         Margin="20,0,20,25">

                <Button x:Name="BtnUsers"
                        Click="BtnUsers_Click"
                        Margin="10"
                        MinHeight="120"
                        Background="{DynamicResource PrimaryColor}"
                        BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Пользователи"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Управление учетными записями"
                                   FontSize="12"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnVehicles"
                        Click="BtnVehicles_Click"
                        Margin="10"
                        MinHeight="120"
                        Background="{DynamicResource AccentColor}"
                        BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Транспорт"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Велосипеды и самокаты"
                                   FontSize="12"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnStations"
                        Click="BtnStations_Click"
                        Margin="10"
                        MinHeight="120"
                        Background="{DynamicResource AccentColor}"
                        BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Станции"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Места размещения транспорта"
                                   FontSize="12"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnRentals"
                        Click="BtnRentals_Click"
                        Margin="10"
                        MinHeight="120"
                        Background="{DynamicResource PrimaryColor}"
                        BorderThickness="0">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Аренды"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Просмотр аренд"
                                   FontSize="12"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </ScrollViewer>
    </Grid>
</Page>
