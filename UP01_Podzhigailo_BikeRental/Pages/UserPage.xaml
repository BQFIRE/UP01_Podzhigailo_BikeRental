<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="UP01_Podzhigailo_BikeRental.Pages.UserPage"
      Title="Аренда транспорта"
      Background="{DynamicResource BackgroundColor}" av:DesignHeight="338.57" av:DesignWidth="623.67">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,5,0,15">
            <TextBlock Text="Аренда транспорта"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextColor}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Выберите велосипед или самокат"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Padding="14,7"
                    Margin="8,0,0,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    BorderThickness="0"
                    DockPanel.Dock="Right"/>

            <TextBlock x:Name="RentalInfoText"
                       Text="У вас нет активной аренды"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextColor}"/>
        </DockPanel>

        <DataGrid x:Name="VehiclesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource CardColor}"
                  Foreground="{DynamicResource TextColor}"
                  BorderBrush="{DynamicResource BorderColor}"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding VehicleID}"
                                    Width="50"/>
                <DataGridTextColumn Header="Модель"
                                    Binding="{Binding Model}"
                                    Width="*"/>
                <DataGridTextColumn Header="Серийный номер"
                                    Binding="{Binding SerialNumber}"
                                    Width="*"/>
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="100"/>
                <DataGridTextColumn Header="Цена/час"
                                    Binding="{Binding PricePerHour}"
                                    Width="100"/>
                <DataGridTextColumn Header="Заряд, %"
                                    Binding="{Binding BatteryLevel}"
                                    Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Арендовать"
                    Click="RentButton_Click"
                    Padding="16,9"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    BorderThickness="0"/>

            <Button Content="Завершить аренду"
                    Click="FinishRentalButton_Click"
                    Padding="16,9"
                    Background="#263238"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Page>
