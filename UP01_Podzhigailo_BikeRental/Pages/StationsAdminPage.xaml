<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="UP01_Podzhigailo_BikeRental.Pages.StationsAdminPage"
      Title="Управление станциями"
      Background="{DynamicResource BackgroundColor}" av:DesignHeight="360.033" av:DesignWidth="676.961">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление станциями"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextColor}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Padding="14,6"
                    Margin="10,0,0,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    BorderThickness="0"
                    DockPanel.Dock="Right"/>

            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBackgroundColor}"
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="{DynamicResource BorderColor}"
                     ToolTip="Поиск по названию или адресу"
                     TextChanged="SearchTextBox_TextChanged"/>
        </DockPanel>

        <DataGrid x:Name="StationsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource CardColor}"
                  Foreground="{DynamicResource TextColor}"
                  BorderBrush="{DynamicResource BorderColor}"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,12">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding StationID}"
                                    Width="60"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Адрес"
                                    Binding="{Binding Address}"
                                    Width="2*"/>

                <DataGridCheckBoxColumn Header="Активна"
                                        Binding="{Binding IsActive}"
                                        Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3">
            <TextBlock x:Name="CountTextBlock"
                       Text="Количество станций: 0"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Добавить"
                        Click="AddButton_Click"
                        Padding="14,8"
                        Margin="5,0"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="Редактировать"
                        Click="EditButton_Click"
                        Padding="14,8"
                        Margin="5,0"/>

                <Button Content="Удалить"
                        Click="DeleteButton_Click"
                        Padding="14,8"
                        Margin="5,0"
                        Background="#B83232"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Page>
