<Page x:Class="UP01_Podzhigailo_BikeRental.Pages.UsersAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление пользователями"
      Background="{DynamicResource BackgroundColor}" Height="373" Width="580">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление пользователями"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextColor}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Padding="14,6"
                    Margin="10,0,0,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    BorderThickness="0"
                    DockPanel.Dock="Right"/>

            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBackgroundColor}"
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="{DynamicResource BorderColor}"
                     ToolTip="Поиск по логину или ФИО"
                     TextChanged="SearchTextBox_TextChanged"/>
        </DockPanel>

        <DataGrid x:Name="UsersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource CardColor}"
                  Foreground="{DynamicResource TextColor}"
                  BorderBrush="{DynamicResource BorderColor}"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,12">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding UserID}"
                                    Width="60"/>

                <DataGridTextColumn Header="Логин"
                                    Binding="{Binding Login}"
                                    Width="*"/>

                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding FullName}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Роль"
                                    Binding="{Binding Role}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3">
            <TextBlock x:Name="CountTextBlock"
                       Text="Количество пользователей: 0"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <Button Content="Изменить роль"
                    Click="ChangeRoleButton_Click"
                    Padding="14,8"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    BorderThickness="0"
                    HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Page>
